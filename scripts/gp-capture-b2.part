if(await p.locator('#accountDlg').evaluate(e=>e.open).catch(()=>false))await p.locator('#accClose').click();await p.screenshot({path:out+'/'+d.n+'-home.png'});const q=String.fromCharCode(1589,1606,1593,1575,1569);await p.locator('#q').fill(q);await p.locator('#searchSubmit').click();await p.waitForSelector('#liveDirectoryItems .live-directory-card',{timeout:60000});await p.screenshot({path:out+'/'+d.n+'-search.png'});console.log(d.n+': captured home and live directory search');