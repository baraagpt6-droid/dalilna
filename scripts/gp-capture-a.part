const fs=require('fs'),{chromium}=require('playwright'),out='dist/google-play-screenshots',url='https://baraagpt6-droid.github.io/dalilna/';fs.mkdirSync(out,{recursive:true});
(async()=>{const b=await chromium.launch();try{for(const d of [{n:'phone',w:432,h:768,s:2.5,m:true},{n:'tablet',w:1280,h:720,s:1.5,m:false}]){const c=await b.newContext({viewport:{width:d.w,height:d.h},deviceScaleFactor:d.s,isMobile:d.m,hasTouch:d.m,locale:'ar-YE'}),p=await c.newPage();await p.goto(url,{waitUntil:'domcontentloaded',timeout:120000});await p.waitForSelector('#tiles',{timeout:60000});await p.waitForTimeout(5000);