await p.evaluate(()=>{const buttons=[...document.querySelectorAll('button[data-go="home"]')].filter(el=>el.getClientRects().length);const target=buttons.at(-1);if(target)target.click();});await p.locator('#tiles').waitFor({state:'visible',timeout:30000});await p.locator('#q').fill(q);await p.locator('#searchSubmit').click();await p.waitForSelector('#liveDirectoryItems .live-directory-card',{timeout:60000});